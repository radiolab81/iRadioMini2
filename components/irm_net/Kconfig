menu "iRadioMini2: Netzwerk"
    config IRM_WIFI_SSID
        string "Fallback-SSID (nur wenn weder SD-Karte noch NVS Zugangsdaten liefern)"
        default ""
    config IRM_WIFI_PASSWORD
        string "Fallback-Passwort"
        default ""
    config IRM_WIFI_HOSTNAME
        string "DHCP-Hostname"
        default "iradiomini"
    config IRM_WIFI_MAX_BACKOFF_S
        int "Maximales Reconnect-Intervall (s)"
        default 30
        range 2 300
endmenu
